# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Windows-specific batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.keystore binary
*.jks binary
*.jar binary
*.so binary
*.aar binary
